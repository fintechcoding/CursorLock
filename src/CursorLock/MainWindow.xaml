<Window x:Class="CursorLock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="CursorLock" Width="650" Height="820" MinWidth="550" MinHeight="680" Background="#10131B" Foreground="#EDF2FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<ScrollViewer Background="#10131B" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Background" Value="#10131B" /></Style></ScrollViewer.Resources><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="CURSORLOCK" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" /><TextBlock Text="Your cursor. Your space." FontSize="28" FontWeight="SemiBold" Margin="0,6,0,5" /><TextBlock Text="One shortcut. One monitor. Stay in the flow." Foreground="{StaticResource MutedBrush}" FontSize="14" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#232C3B" CornerRadius="6" Padding="9,4"><TextBlock Text="v1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" /></Border></Grid>
<Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><Grid><StackPanel><TextBlock Text="CURSOR STATUS" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="StatusText" Text="Unlocked" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel><Button x:Name="ToggleButton" Content="Lock monitor" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="#102820" Click="ToggleClick" /></Grid><TextBlock x:Name="StatusDescription" Margin="0,12,0,10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" /><Canvas x:Name="MonitorCanvas" Height="125" ClipToBounds="True" SizeChanged="MonitorSizeChanged" /><TextBlock Text="Your cursor moves freely inside the monitor, without crossing its edges." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="KEYBOARD SHORTCUT" FontSize="11" Foreground="{StaticResource MutedBrush}" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="HotkeyBox" IsReadOnly="True" Background="#10131B" Foreground="#EDF2FA" BorderBrush="#39465D" BorderThickness="1" Padding="12,10" FontSize="17" VerticalContentAlignment="Center" PreviewKeyDown="CaptureHotkey" ToolTip="Click here, then press Ctrl / Alt / Shift with a letter, number or F1–F11." AutomationProperties.Name="Keyboard shortcut" /><Button Grid.Column="1" Content="Save" Margin="12,0,0,0" Click="SaveHotkeyClick" /></Grid><TextBlock Text="Select the field and press your new shortcut. Use the same shortcut to lock and unlock." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" /></StackPanel></Border>
<Border Grid.Row="3" Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="StartupClick" /><TextBlock Text="Starts quietly in the system tray. Your cursor stays unlocked until you use the shortcut." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" /></StackPanel></Border>
<TextBlock Grid.Row="4" x:Name="FeedbackText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14" Visibility="Collapsed" />
<Grid Grid.Row="5"><StackPanel VerticalAlignment="Center"><TextBlock Text="Closing this window keeps CursorLock in the tray." Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="Use Exit to unlock your cursor and quit." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><Button Content="Exit" HorizontalAlignment="Right" Click="ExitClick" /></Grid>
</Grid></ScrollViewer></Window>
