<Window x:Class="CursorLock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="CursorLock" Width="650" Height="820" MinWidth="550" MinHeight="680" Background="#F3F3F3" Foreground="#1B1B1B" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<ScrollViewer Background="#F3F3F3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Background" Value="#F3F3F3" /></Style></ScrollViewer.Resources><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="CURSORLOCK" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" /><TextBlock Text="Your cursor. Your space." FontSize="28" FontWeight="SemiBold" Margin="0,6,0,5" /><TextBlock Text="One shortcut. One monitor. Stay in the flow." Foreground="{StaticResource MutedBrush}" FontSize="14" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E6E9EF" CornerRadius="6" Padding="9,4"><TextBlock Text="v1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" /></Border></Grid>
<Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><Grid><StackPanel><TextBlock Text="CURSOR STATUS" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="StatusText" Text="Unlocked" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel><Button x:Name="ToggleButton" Content="Lock monitor" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" Click="ToggleClick" /></Grid><TextBlock x:Name="StatusDescription" Margin="0,12,0,10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" /><Canvas x:Name="MonitorCanvas" Height="125" ClipToBounds="True" SizeChanged="MonitorSizeChanged" /><TextBlock Text="Your cursor moves freely inside the monitor. Hold your cross-monitor key to cross to another monitor and move a window across." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="KEYBOARD SHORTCUT" FontSize="11" Foreground="{StaticResource MutedBrush}" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="HotkeyBox" IsReadOnly="True" Background="#FFFFFF" Foreground="#1B1B1B" BorderBrush="#C9CDD4" BorderThickness="1" Padding="12,10" FontSize="17" VerticalContentAlignment="Center" PreviewKeyDown="CaptureHotkey" ToolTip="Click here, then press Ctrl / Alt / Shift with a letter, number or F1–F11." AutomationProperties.Name="Keyboard shortcut" /><Button Grid.Column="1" Content="Save" Margin="12,0,0,0" Click="SaveHotkeyClick" /></Grid><TextBlock Text="Select the field and press your new shortcut. Use the same shortcut to lock and unlock." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" /><TextBlock Text="HOLD TO CROSS MONITORS" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0" /><ComboBox x:Name="CrossKeyBox" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="10,7" SelectionChanged="CrossKeyChanged"><ComboBoxItem Content="Ctrl" Tag="17" /><ComboBoxItem Content="Alt" Tag="18" /><ComboBoxItem Content="Shift" Tag="16" /><ComboBoxItem Content="Off" Tag="0" /></ComboBox><TextBlock Text="Hold this key while locked to move the cursor to another monitor, then release to re-lock there." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" /></StackPanel></Border>
<Border Grid.Row="3" Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="StartupClick" /><TextBlock Text="Starts quietly in the system tray. Your cursor stays unlocked until you use the shortcut." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" /><CheckBox x:Name="ShowDesktopCheck" Content="Win + D minimizes only the monitor under the cursor" Click="ShowDesktopClick" Margin="0,18,0,0" /><TextBlock Text="Replaces the system Win + D. Press once to minimize the windows on the monitor your cursor is on; press again to bring them back." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" /></StackPanel></Border>
<TextBlock Grid.Row="4" x:Name="FeedbackText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14" Visibility="Collapsed" />
<Grid Grid.Row="5"><StackPanel VerticalAlignment="Center"><TextBlock Text="Closing this window keeps CursorLock in the tray." Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="Use Exit to unlock your cursor and quit." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><Button Content="Exit" HorizontalAlignment="Right" Click="ExitClick" /></Grid>
</Grid></ScrollViewer></Window>
